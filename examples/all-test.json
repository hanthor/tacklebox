      "image": "localhost/superiso-live-aurora:latest",
      "desktop": "kde",
      "modes": ["live"]
    },
    {
      "id": "dakota",
      "image": "ghcr.io/projectbluefin/dakota:latest",
      "desktop": "gnome",
      "backend": "composefs",
      "modes": ["live"]
    }
  ]
}