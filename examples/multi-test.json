{
  "media_name": "Tacklebox-Multi-Boot-Media",
  "size": "30G",
  "shared_store": {
    "format": "ext4",
    "compression": "zstd"
  },
  "bootable_environments": [
    {
      "id": "bluefin",
      "image": "localhost/superiso-live-bluefin:latest",
      "desktop": "gnome",
      "modes": ["live", "persistent"]
    },
    {
      "id": "bazzite",
      "image": "ghcr.io/ublue-os/bazzite:stable",
      "desktop": "kde",
      "modes": ["live"]
    },
    {
      "id": "dakota",
      "image": "ghcr.io/projectbluefin/dakota:latest",
      "desktop": "gnome",
      "backend": "composefs",
      "modes": ["live"]
    }
  ],
  "offline_payloads": [
    "ghcr.io/projectbluefin/dakota:latest"
  ]
}
